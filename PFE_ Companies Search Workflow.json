    {
      "parameters": {
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\n const socialMediaDomains = [\n    'facebook.com',\n    'fb.com',\n    'instagram.com',\n    'linkedin.com',\n    'tiktok.com',\n    'youtube.com',\n    'pinterest.com',\n    'snapchat.com',\n    'whatsapp.com',\n    't.me',\n    'telegram.org',\n     '.fr'\n  ];\n\nconst dups = new Set()\n\nfor (const item of $input.all()) {\n  item.json.results = item.json.results.filter(row => {\n    // Check if URL is missing or empty\n    if (!row.url || row.url.trim() === '' || dups.has(row.url) || socialMediaDomains.find(domain => row.url.includes(domain))) {\n      return false;\n    }\n    dups.add(row.url)\n    return true\n  })\n}\n\nreturn $input.all();"
      },
